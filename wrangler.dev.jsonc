// Local development and end-to-end tests only. Never deployed.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "take-home-tracker-dev",
  "main": "./src/worker/dev.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // If someone deploys this by mistake, it gets no public address.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  // 20 model calls a minute per user (D13).
  "ratelimits": [
    { "name": "MODEL_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ]
  // MODEL_ALLOWED_EMAILS comes from .dev.vars, like the production secret (D13).
}
